POWERCHAIN_MINER_API_URL=http://localhost:3100
POWERCHAIN_WORKER_TOKEN=replace-with-at-least-32-random-characters
POWERCHAIN_SOLANA_RPC_URL=https://api.devnet.solana.com
POWERCHAIN_MINER_PROGRAM_ID=
POWERCHAIN_VERIFIER_KEYPAIR=/secure/path/verifier-keypair.json
POWERCHAIN_MINER_IDL=../../target/idl/powerchain_miner.json
POLL_INTERVAL_MS=5000

# Stable identifier recommended for multi-instance deployments.
# If omitted, the worker derives hostname:pid:random-suffix for the current process.
POWERCHAIN_WORKER_INSTANCE_ID=
POWERCHAIN_SETTLEMENT_LEASE_SECONDS=180
POWERCHAIN_SETTLEMENT_LEASE_LIMIT=25
