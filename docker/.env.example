# Local Docker stack only. Replace every secret before using outside localhost.
POSTGRES_DB=powerchain_miner
POSTGRES_USER=powerchain
POSTGRES_PASSWORD=powerchain-local-dev

JWT_SECRET=powerchain-local-jwt-secret-change-this-000000000000
SUPERADMIN_EMAIL=admin@powerchain.local
SUPERADMIN_PASSWORD=change-this-local-password

POWERCHAIN_WORKER_TOKEN=powerchain-local-worker-token-000000000000000000
POWERCHAIN_EVIDENCE_WORKER_TOKEN=powerchain-local-evidence-token-00000000000000
POWERCHAIN_COMPUTE_GATEWAY_TOKEN=powerchain-local-compute-token-000000000000000

POWERCHAIN_NETWORK=devnet
POWERCHAIN_SOLANA_RPC_URL=https://api.devnet.solana.com
POWERCHAIN_MINER_PROGRAM_ID=
POWERCHAIN_MINER_MINT=
POWERCHAIN_MINER_TREASURY_VAULT=

# Agent Compute is opt-in via `--profile compute`.
COMPUTE_UPSTREAM_BASE_URL=https://api.openai.com/v1
COMPUTE_UPSTREAM_API_KEY=

NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
