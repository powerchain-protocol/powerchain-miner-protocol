# Server-side BFF target.
POWERCHAIN_MINER_API_URL=http://localhost:3100

# Browser RPC used only for user-wallet transaction submission.
# Keep it on the same cluster as POWERCHAIN_NETWORK / Miner API.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Deprecated Next.js device-ingestion preview. Keep false in production.
POWERCHAIN_ENABLE_PREVIEW_API=false

# The values below are needed only when explicitly enabling the legacy preview API.
POWERCHAIN_NETWORK=devnet
POWERCHAIN_SOLANA_RPC_URL=https://api.devnet.solana.com
POWERCHAIN_MINER_PROGRAM_ID=
POWERCHAIN_MINER_MINT=

# Public UI identity only. Never place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_POWERCHAIN_NETWORK=devnet
NEXT_PUBLIC_APP_ENVIRONMENT=development
