NODE_ENV=development
PORT=3100
HOST=0.0.0.0

DATABASE_URL=postgres://powerchain:powerchain@localhost:5432/powerchain_miner

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=powerchain-miner-api
JWT_AUDIENCE=powerchain-miner-console
CORS_ORIGINS=http://localhost:3000

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-strong-password

# Canonical Solana settlement configuration.
POWERCHAIN_NETWORK=devnet
POWERCHAIN_SOLANA_RPC_URL=https://api.devnet.solana.com
POWERCHAIN_MINER_PROGRAM_ID=
POWERCHAIN_MINER_MINT=
POWERCHAIN_MINER_TREASURY_VAULT=

# Service-to-service credentials. Use different random secrets.
POWERCHAIN_WORKER_TOKEN=replace-with-at-least-32-random-characters
POWERCHAIN_EVIDENCE_WORKER_TOKEN=replace-with-another-32-character-random-secret
VERIFIER_MAX_ATTEMPTS=8

# Optional bearer protection for /metrics.
METRICS_TOKEN=


# Agent Compute control-plane/data-plane credential.
# Must be different from verifier/evidence-worker credentials.
POWERCHAIN_COMPUTE_GATEWAY_TOKEN=replace-with-a-third-32-character-random-secret

# Optional bootstrap configuration for `pnpm compute:seed`.
# Rates are compute-credit microunits per 1,000 tokens.
COMPUTE_DEFAULT_PUBLIC_MODEL=
COMPUTE_DEFAULT_UPSTREAM_MODEL=
COMPUTE_DEFAULT_INPUT_RATE_MICROUNITS_PER_1K=
COMPUTE_DEFAULT_CACHED_INPUT_RATE_MICROUNITS_PER_1K=
COMPUTE_DEFAULT_OUTPUT_RATE_MICROUNITS_PER_1K=
COMPUTE_DEFAULT_MAX_OUTPUT_TOKENS=8192
COMPUTE_DEFAULT_CONTEXT_LENGTH=

# Solana funding asset. No value is assumed by the code.
COMPUTE_SOLANA_FUNDING_SYMBOL=USDC
COMPUTE_SOLANA_FUNDING_MINT=
COMPUTE_SOLANA_TREASURY_TOKEN_ACCOUNT=
COMPUTE_SOLANA_ASSET_DECIMALS=6
COMPUTE_SOLANA_CREDIT_MICROUNITS_PER_BASE_UNIT=1
