{
  "info": {
    "name": "PowerChain Renewable Miner & Agent Compute API v1.0.0",
    "_postman_id": "powerchain-renewable-miner-v100",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3100"
    },
    {
      "key": "jwt",
      "value": ""
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "claimId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@example.com\",\"password\":\"change-me\"}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Clients",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/clients"
      }
    },
    {
      "name": "Prepare reward claim",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/reward-claims/{{claimId}}/prepare"
      }
    },
    {
      "name": "Reconcile reward claim",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"signature\":\"<confirmed-solana-signature>\"}"
        },
        "url": "{{baseUrl}}/api/v1/reward-claims/{{claimId}}/settled"
      }
    },
    {
      "name": "Verify audit chain",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/audit/verify?clientId={{clientId}}"
      }
    },
    {
      "name": "Protocol Core",
      "item": [
        {
          "name": "Capabilities",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/core/capabilities"
          }
        },
        {
          "name": "Agent Characters",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/core/characters"
          }
        }
      ]
    },
    {
      "name": "Chain Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health/chain"
      }
    },
    {
      "name": "Reward Claim Approval Policy",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/clients/{{clientId}}/reward-claim-approval-policy"
      }
    },
    {
      "name": "Lease Proof Settlements",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{workerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"workerId\": \"verifier-01\",\n  \"limit\": 25,\n  \"leaseSeconds\": 180\n}"
        },
        "url": "{{baseUrl}}/api/v1/internal/proofs/lease"
      }
    }
  ]
}
