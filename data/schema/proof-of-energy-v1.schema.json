{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerchain.ventures/schema/proof-of-energy-v1.json",
  "title": "PowerChain Proof of Energy v1",
  "type": "object",
  "required": [
    "sequence",
    "observedAt",
    "renewableType",
    "energyDeltaWh",
    "averagePowerW",
    "sampleCount",
    "source",
    "qualityBps",
    "sourceHash",
    "previousDigest"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "renewableType": {
      "enum": [
        "solar",
        "wind",
        "hydro",
        "battery",
        "ev",
        "other"
      ]
    },
    "energyDeltaWh": {
      "type": "integer",
      "minimum": 1
    },
    "averagePowerW": {
      "type": "integer",
      "minimum": 0
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "qualityBps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "previousDigest": {
      "type": "string"
    }
  },
  "additionalProperties": false
}