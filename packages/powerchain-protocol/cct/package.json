{
  "name": "@powerchain-protocol/cct",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "default": "./dist/constants.js"
    },
    "./pdas": {
      "types": "./dist/pdas.d.ts",
      "import": "./dist/pdas.js",
      "default": "./dist/pdas.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "corepack pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pack:inspect": "npm pack --dry-run --json",
    "prepack": "corepack pnpm build",
    "prepublishOnly": "corepack pnpm typecheck && corepack pnpm build"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "description": "Canonical PowerChain Carbon Credit Token (CCT) contracts, PDAs, units, issuance and retirement types.",
  "sideEffects": false,
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powerchain-protocol/powerchain-miner-protocol.git",
    "directory": "packages/powerchain-protocol/cct"
  },
  "publishConfig": {
    "access": "public"
  }
}
