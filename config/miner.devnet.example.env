SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Generated by: solana-keygen new -o target/deploy/powerchain_miner-devnet-keypair.json
PROGRAM_KEYPAIR=target/deploy/powerchain_miner-devnet-keypair.json

TOKEN_PROGRAM_ID=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
MINER_TOKEN_NAME=PowerChain Miner Devnet
MINER_TOKEN_SYMBOL=MINER
MINER_TOKEN_DECIMALS=9
MINER_METADATA_URI=https://example.invalid/miner-devnet.json

# Devnet-only test economics. Base units are 10^-9 MINER.
# Mainnet values MUST be reviewed independently.
MINER_GENESIS_SUPPLY=1000000000
MINER_EMISSION_CAP_BASE_UNITS=1000000000000000000
REWARD_PER_WORK_UNIT_BASE_UNITS=1000000
MAX_REWARD_PER_PROOF_BASE_UNITS=100000000000
MAX_ENERGY_WH_PER_PROOF=10000000
MIN_QUALITY_BPS=9000
MAX_PROOF_AGE_SECS=900
# Global ceiling for observation -> verification delay. Client policy may be stricter.
MAX_OBSERVATION_AGE_SECS=2592000
MAX_CLOCK_SKEW_SECS=120
EPOCH_SECONDS=3600

# Address that is allowed to attest verified device proofs.
VERIFIER_PUBKEY=

# Filled after create-miner-token.sh
POWERCHAIN_MINER_MINT=
# Filled after sync-program-id.sh / deploy
POWERCHAIN_MINER_PROGRAM_ID=
# Used by miner:initialize. Keep outside Git.
ADMIN_KEYPAIR=~/.config/solana/id.json
POWERCHAIN_MINER_IDL=target/idl/powerchain_miner.json
