POWERCHAIN_SOLANA_RPC_URL=https://api.devnet.solana.com
POWERCHAIN_MINER_PROGRAM_ID=
POWERCHAIN_MINER_IDL=target/idl/powerchain_miner.json

# Protocol authority pays for the DeviceAccount.
ADMIN_KEYPAIR=~/.config/solana/id.json

# Registered reward owner; signs the register_device instruction.
OWNER_KEYPAIR=~/.config/solana/id.json

# Base58 Ed25519/Solana public key reported directly by:
#   minerctl identity-solana
DEVICE_SIGNING_PUBKEY=
