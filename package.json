{
  "name": "powerchain-renewable-miner",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "dev": "corepack pnpm dev:console",
    "build": "corepack pnpm build:web",
    "start": "corepack pnpm --filter @powerchain/console start",
    "typecheck": "corepack pnpm build:protocol-miner && corepack pnpm typecheck:console && corepack pnpm typecheck:frontend && corepack pnpm typecheck:mobile && corepack pnpm typecheck:design && corepack pnpm typecheck:api-client && corepack pnpm typecheck:compute && corepack pnpm typecheck:agent-compute && corepack pnpm typecheck:protocol-miner && corepack pnpm typecheck:cct",
    "dev:verifier": "corepack pnpm --filter @powerchain/miner-verifier-worker dev",
    "typecheck:verifier": "corepack pnpm --filter @powerchain/miner-verifier-worker typecheck",
    "dev:api": "corepack pnpm --filter @powerchain/backend dev",
    "api:typecheck": "corepack pnpm --filter @powerchain/backend typecheck",
    "db:migrate": "corepack pnpm --filter @powerchain/backend db:migrate",
    "db:seed": "corepack pnpm --filter @powerchain/backend db:seed",
    "check": "./scripts/check.sh",
    "test": "./scripts/test.sh",
    "build:all": "./scripts/build.sh",
    "dev:stack": "./scripts/devnet-up.sh",
    "migrate": "corepack pnpm db:migrate",
    "diagnostics": "./scripts/diagnostics.sh",
    "openapi:check": "node scripts/check-openapi.mjs",
    "dev:evidence": "corepack pnpm --filter @powerchain/evidence-verifier dev",
    "typecheck:evidence": "corepack pnpm --filter @powerchain/evidence-verifier typecheck",
    "verifier:keygen": "node scripts/generate-evidence-verifier-key.mjs",
    "db:smoke": "corepack pnpm --filter @powerchain/backend db:smoke",
    "release:preflight": "./scripts/release-preflight.sh",
    "deployment:verify": "node scripts/verify-deployment-manifest.mjs",
    "typecheck:sdk": "corepack pnpm --filter @powerchain/miner-sdk typecheck",
    "miner:initialize": "corepack pnpm --filter @powerchain/miner-sdk initialize",
    "miner:register-owner": "corepack pnpm --filter @powerchain/miner-sdk register-owner",
    "miner:register-device": "corepack pnpm --filter @powerchain/miner-sdk register-device",
    "miner:inspect": "corepack pnpm --filter @powerchain/miner-sdk inspect",
    "miner:reassign-device": "corepack pnpm --filter @powerchain/miner-sdk reassign-device",
    "dev:console": "corepack pnpm --filter @powerchain/console dev",
    "dev:frontend": "corepack pnpm --filter @powerchain/frontend dev",
    "dev:mobile": "corepack pnpm --filter @powerchain/mobile dev",
    "dev:backend": "corepack pnpm --filter @powerchain/backend dev",
    "build:console": "corepack pnpm --filter @powerchain/console build",
    "build:frontend": "corepack pnpm --filter @powerchain/frontend build",
    "build:web": "corepack pnpm build:console && corepack pnpm build:frontend",
    "typecheck:console": "corepack pnpm --filter @powerchain/console typecheck",
    "typecheck:frontend": "corepack pnpm --filter @powerchain/frontend typecheck",
    "typecheck:mobile": "corepack pnpm --filter @powerchain/mobile typecheck",
    "typecheck:design": "corepack pnpm --filter @powerchain/design-system typecheck",
    "typecheck:api-client": "corepack pnpm --filter @powerchain/api-client typecheck",
    "dev:compute": "corepack pnpm --filter @powerchain/compute dev",
    "typecheck:compute": "corepack pnpm --filter @powerchain/compute typecheck",
    "typecheck:agent-compute": "corepack pnpm --filter @powerchain/agent-compute typecheck",
    "compute:seed": "corepack pnpm --filter @powerchain/backend compute:seed",
    "compute:models": "node utilities/model-routing/list-models.mjs",
    "skills:install": "node scripts/install-agent-skills.mjs all",
    "skills:zip": "python3 scripts/package-agent-skills.py",
    "codex:proxy": "./scripts/codex-proxy.sh",
    "codex:on": "node scripts/configure-codex-powerchain-apc.mjs on",
    "codex:off": "node scripts/configure-codex-powerchain-apc.mjs off",
    "claude:on": "node scripts/configure-claude-powerchain-apc.mjs on",
    "claude:off": "node scripts/configure-claude-powerchain-apc.mjs off",
    "bootstrap": "./scripts/bootstrap-dev.sh",
    "doctor": "./scripts/doctor.sh",
    "db:up": "./scripts/db-up.sh",
    "db:down": "./scripts/db-down.sh",
    "deps:build-policy": "node scripts/check-pnpm-build-policy.mjs",
    "deps:review": "corepack pnpm ignored-builds",
    "peers:check": "corepack pnpm peers check",
    "dev:apps": "corepack pnpm -r --parallel --filter @powerchain/backend --filter @powerchain/console --filter @powerchain/compute --filter @powerchain/frontend run dev",
    "typecheck:protocol-miner": "corepack pnpm --filter @powerchain-protocol/miner typecheck",
    "docker:build": "./scripts/docker-compose.sh build",
    "docker:up": "./scripts/docker-compose.sh up -d",
    "docker:down": "./scripts/docker-compose.sh down",
    "docker:logs": "./scripts/docker-compose.sh logs -f",
    "docker:ps": "./scripts/docker-compose.sh ps",
    "docker:compute": "./scripts/docker-compose.sh --profile compute up -d compute",
    "docker:mobile": "./scripts/docker-compose.sh --profile mobile up mobile",
    "docker:config": "./scripts/docker-compose.sh config",
    "docs:check": "node scripts/check-docs.mjs",
    "bootstrap:db": "./scripts/bootstrap-dev.sh --require-db",
    "bootstrap:no-db": "./scripts/bootstrap-dev.sh --skip-db",
    "program:check": "node scripts/check-miner-program.mjs && node scripts/check-cct-program.mjs",
    "program:doctor": "./scripts/program-doctor.sh",
    "program:fmt": "cargo fmt --all -- --check",
    "program:test": "cargo test --workspace",
    "program:build": "anchor build",
    "program:sync-id": "./scripts/sync-program-id.sh",
    "program:deploy": "./scripts/deploy-miner.sh",
    "program:anchor-test": "anchor test",
    "console:ui:add": "corepack pnpm --filter @powerchain/console exec shadcn add",
    "build:protocol-miner": "corepack pnpm --filter @powerchain-protocol/miner build",
    "package:miner:build": "corepack pnpm --filter @powerchain-protocol/miner build",
    "package:miner:inspect": "corepack pnpm --filter @powerchain-protocol/miner pack:inspect",
    "package:miner:publish": "./scripts/npm-publish-miner.sh",
    "pay:version": "npx --yes @solana/pay@1.0.26 --version",
    "pay:sandbox": "./scripts/pay-sandbox.sh",
    "secrets:check": "node scripts/check-secrets.mjs",
    "miner:update-rules": "corepack pnpm --filter @powerchain/miner-sdk update-mining-rules",
    "pnpm:version": "corepack pnpm --version",
    "deps:uuid": "corepack pnpm -r why uuid",
    "deps:check": "corepack pnpm peers check && corepack pnpm -r why uuid",
    "package:miner:pack": "mkdir -p target/packages && corepack pnpm --filter @powerchain-protocol/miner build && npm pack ./packages/powerchain-protocol/miner --pack-destination target/packages",
    "npm:secrets:check": "node scripts/check-secrets.mjs",
    "console:architecture": "node scripts/check-console-architecture.mjs",
    "quality": "corepack pnpm repo:organization && corepack pnpm console:architecture && corepack pnpm docs:check && corepack pnpm secrets:check && corepack pnpm check",
    "repo:organization": "node scripts/check-repository-organization.mjs",
    "typecheck:cct": "corepack pnpm --filter @powerchain-protocol/cct typecheck",
    "program:cct:check": "node scripts/check-cct-program.mjs",
    "program:cct:fmt": "cargo fmt --manifest-path programs/cct/Cargo.toml --all -- --check",
    "program:cct:test": "cargo test --manifest-path programs/cct/Cargo.toml",
    "services:check": "node scripts/check-services.mjs",
    "integrations:check": "node scripts/check-solana-integrations.mjs",
    "helium:rpm": "./linux/rpm/helium/build-rpm.sh",
    "program:miner:check": "node scripts/check-miner-program.mjs",
    "program:miner:sync-id": "./scripts/sync-program-id.sh",
    "program:cct:sync-id": "./scripts/sync-cct-program-id.sh",
    "build:cct": "corepack pnpm --filter @powerchain-protocol/cct build",
    "pack:cct": "corepack pnpm --filter @powerchain-protocol/cct pack:inspect",
    "deps:security": "node scripts/check-dependency-security.mjs",
    "deps:refresh-lockfile": "corepack pnpm install --lockfile-only --no-frozen-lockfile && node scripts/check-dependency-security.mjs"
  },
  "pnpm": {
    "overrides": {
      "uuid@<11.1.1": "11.1.1",
      "uuid@12.0.0": "12.0.1",
      "uuid@13.0.0": "13.0.1"
    }
  }
}
