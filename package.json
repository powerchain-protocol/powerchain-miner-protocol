{
  "name": "powerchain-renewable-miner",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "pnpm dev:console",
    "build": "pnpm build:web",
    "start": "pnpm --filter @powerchain/console start",
    "typecheck": "pnpm typecheck:console && pnpm typecheck:frontend && pnpm typecheck:mobile && pnpm typecheck:design && pnpm typecheck:api-client && pnpm typecheck:compute && pnpm typecheck:agent-compute && pnpm typecheck:protocol-miner",
    "dev:verifier": "pnpm --filter @powerchain/miner-verifier-worker dev",
    "typecheck:verifier": "pnpm --filter @powerchain/miner-verifier-worker typecheck",
    "dev:api": "pnpm --filter @powerchain/backend dev",
    "api:typecheck": "pnpm --filter @powerchain/backend typecheck",
    "db:migrate": "pnpm --filter @powerchain/backend db:migrate",
    "db:seed": "pnpm --filter @powerchain/backend db:seed",
    "check": "./scripts/check.sh",
    "test": "./scripts/test.sh",
    "build:all": "./scripts/build.sh",
    "dev:stack": "./scripts/devnet-up.sh",
    "migrate": "pnpm db:migrate",
    "diagnostics": "./scripts/diagnostics.sh",
    "openapi:check": "node scripts/check-openapi.mjs",
    "dev:evidence": "pnpm --filter @powerchain/evidence-verifier dev",
    "typecheck:evidence": "pnpm --filter @powerchain/evidence-verifier typecheck",
    "verifier:keygen": "node scripts/generate-evidence-verifier-key.mjs",
    "db:smoke": "pnpm --filter @powerchain/backend db:smoke",
    "release:preflight": "./scripts/release-preflight.sh",
    "deployment:verify": "node scripts/verify-deployment-manifest.mjs",
    "typecheck:sdk": "pnpm --filter @powerchain/miner-sdk typecheck",
    "miner:initialize": "pnpm --filter @powerchain/miner-sdk initialize",
    "miner:register-owner": "pnpm --filter @powerchain/miner-sdk register-owner",
    "miner:register-device": "pnpm --filter @powerchain/miner-sdk register-device",
    "miner:inspect": "pnpm --filter @powerchain/miner-sdk inspect",
    "miner:reassign-device": "pnpm --filter @powerchain/miner-sdk reassign-device",
    "dev:console": "pnpm --filter @powerchain/console dev",
    "dev:frontend": "pnpm --filter @powerchain/frontend dev",
    "dev:mobile": "pnpm --filter @powerchain/mobile dev",
    "dev:backend": "pnpm --filter @powerchain/backend dev",
    "build:console": "pnpm --filter @powerchain/console build",
    "build:frontend": "pnpm --filter @powerchain/frontend build",
    "build:web": "pnpm build:console && pnpm build:frontend",
    "typecheck:console": "pnpm --filter @powerchain/console typecheck",
    "typecheck:frontend": "pnpm --filter @powerchain/frontend typecheck",
    "typecheck:mobile": "pnpm --filter @powerchain/mobile typecheck",
    "typecheck:design": "pnpm --filter @powerchain/design-system typecheck",
    "typecheck:api-client": "pnpm --filter @powerchain/api-client typecheck",
    "dev:compute": "pnpm --filter @powerchain/compute dev",
    "typecheck:compute": "pnpm --filter @powerchain/compute typecheck",
    "typecheck:agent-compute": "pnpm --filter @powerchain/agent-compute typecheck",
    "compute:seed": "pnpm --filter @powerchain/backend compute:seed",
    "compute:models": "node utilities/model-routing/list-models.mjs",
    "skills:install": "node scripts/install-agent-skills.mjs all",
    "skills:zip": "python3 scripts/package-agent-skills.py",
    "codex:proxy": "./scripts/codex-proxy.sh",
    "codex:on": "node scripts/configure-codex-powerchain-apc.mjs on",
    "codex:off": "node scripts/configure-codex-powerchain-apc.mjs off",
    "claude:on": "node scripts/configure-claude-powerchain-apc.mjs on",
    "claude:off": "node scripts/configure-claude-powerchain-apc.mjs off",
    "bootstrap": "./scripts/bootstrap-dev.sh",
    "doctor": "./scripts/doctor.sh",
    "db:up": "./scripts/db-up.sh",
    "db:down": "./scripts/db-down.sh",
    "deps:build-policy": "node scripts/check-pnpm-build-policy.mjs",
    "deps:review": "pnpm ignored-builds",
    "peers:check": "pnpm peers check",
    "dev:apps": "pnpm -r --parallel --filter @powerchain/backend --filter @powerchain/console --filter @powerchain/compute --filter @powerchain/frontend run dev",
    "typecheck:protocol-miner": "pnpm --filter @powerchain-protocol/miner typecheck",
    "docker:build": "./scripts/docker-compose.sh build",
    "docker:up": "./scripts/docker-compose.sh up -d",
    "docker:down": "./scripts/docker-compose.sh down",
    "docker:logs": "./scripts/docker-compose.sh logs -f",
    "docker:ps": "./scripts/docker-compose.sh ps",
    "docker:compute": "./scripts/docker-compose.sh --profile compute up -d compute",
    "docker:mobile": "./scripts/docker-compose.sh --profile mobile up mobile",
    "docker:config": "./scripts/docker-compose.sh config",
    "docs:check": "node scripts/check-docs.mjs",
    "bootstrap:db": "./scripts/bootstrap-dev.sh --require-db",
    "bootstrap:no-db": "./scripts/bootstrap-dev.sh --skip-db",
    "program:check": "node scripts/check-miner-program.mjs",
    "program:doctor": "./scripts/program-doctor.sh",
    "program:fmt": "cargo fmt --manifest-path programs/miner/Cargo.toml --all -- --check",
    "program:test": "cargo test --manifest-path programs/miner/Cargo.toml",
    "program:build": "anchor build",
    "program:sync-id": "./scripts/sync-program-id.sh",
    "program:deploy": "./scripts/deploy-miner.sh",
    "program:anchor-test": "anchor test",
    "console:ui:add": "pnpm --filter @powerchain/console exec shadcn add"
  }
}
